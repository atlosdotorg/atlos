<div class="flex flex-col gap-y-6">
  <div class="prose prose-sm">
    <p>
      <strong><%= @request.client.client_name %></strong>
      wants to access Atlos as you (<strong><%= @current_user.username %></strong>).
      Once connected, it will be able to work in all of your projects, doing whatever you choose
      below, but never more than your role in each project allows. Activity will appear under
      your name.
    </p>
    <p class="text-neutral-600">
      After you decide, you'll be sent to <strong><%= redirect_host(@request.redirect_uri) %></strong>.
      Only connect applications you trust.
    </p>
  </div>

  <%= if Enum.empty?(@memberships) do %>
    <div class="aside ~warning">
      <p>
        You aren't a member of any project you can connect. Ask a project owner to add you to a
        project, then try again.
      </p>
    </div>
  <% end %>

  <form
    method="post"
    action={Routes.o_auth_authorize_path(@conn, :create)}
    class="phx-form flex flex-col gap-y-4"
  >
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
    <%= for {name, value} <- @request_params do %>
      <input type="hidden" name={name} value={value} />
    <% end %>

    <%= if not Enum.empty?(@memberships) do %>
      <fieldset class="flex flex-col gap-2">
        <legend class="mb-2 block text-sm font-medium text-gray-700">Access</legend>
        <%= if "edit" in @offered_scopes do %>
          <label class="!flex gap-2 items-start !font-normal !mt-0">
            <input type="radio" name="access" value="edit" checked />
            <span>
              Read, comment, and edit — view incidents, post comments, add source material, create
              incidents, and change attributes
            </span>
          </label>
        <% end %>
        <%= if "comment" in @offered_scopes do %>
          <label class="!flex gap-2 items-start !font-normal !mt-0">
            <input
              type="radio"
              name="access"
              value="comment"
              checked={"edit" not in @offered_scopes}
            />
            <span>Read and comment — view incidents and post comments</span>
          </label>
        <% end %>
        <label class="!flex gap-2 items-start !font-normal !mt-0">
          <input
            type="radio"
            name="access"
            value="read"
            checked={"comment" not in @offered_scopes}
          />
          <span>Read only — view incidents, their activity, and source material</span>
        </label>
      </fieldset>

      <div>
        <p class="block text-sm font-medium text-gray-700 mb-2">
          Projects it can access (<%= length(@memberships) %>)
        </p>
        <ul class="text-sm divide-y border rounded-md max-h-48 overflow-y-auto">
          <li :for={membership <- @memberships} class="flex justify-between gap-4 px-3 py-2">
            <span class="text-neutral-800"><%= membership.project.name %></span>
            <span class="text-neutral-500 whitespace-nowrap">
              <%= role_limit(membership.role) %>
            </span>
          </li>
        </ul>
        <p class="text-xs text-neutral-500 mt-2">
          This includes projects you join later. Projects where you're a data-only viewer aren't
          included.
        </p>
      </div>
    <% end %>

    <div class="flex gap-4 items-center">
      <%= if not Enum.empty?(@memberships) do %>
        <button type="submit" name="decision" value="approve" class="button ~urge @high">
          Connect
        </button>
      <% end %>
      <button type="submit" name="decision" value="deny" class="base-button">
        Cancel
      </button>
    </div>
  </form>

  <p class="text-sm text-neutral-500">
    You can disconnect applications at any time from your <a
      href="/settings#connected-apps"
      class="underline"
    >account settings</a>.
  </p>
</div>
