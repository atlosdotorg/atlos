<section class="flex flex-col items-center gap-4">
  <Heroicons.exclamation_triangle class="h-12 w-12 text-critical-500" />
  <div class="prose prose-sm text-center">
    <p><%= @message %></p>
    <p>
      Try connecting again from the application. If the problem continues, contact its developer.
    </p>
  </div>
  <a href="/" class="base-button">Return home</a>
</section>
