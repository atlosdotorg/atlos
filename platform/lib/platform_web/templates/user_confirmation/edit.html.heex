<div class="phx-form">
    <%= gettext("Thank you for joining Atlos. Click the button below to confirm that this email belongs to you.") %>
  <.form
    :let={_f}
    for={%{}}
    as={:user}
    action={Routes.user_confirmation_path(@conn, :update, @token)}
  >
    <div class="md:flex gap-2 items-center text-neutral-600">
      <%= submit(gettext("Confirm my account"), class: "button ~urge @high mr-2") %>
      <%= link(gettext("Register"), to: Routes.user_registration_path(@conn, :new)) %>
      <%= link(gettext("Log in"), to: Routes.user_session_path(@conn, :new)) %>
    </div>
  </.form>
</div>
