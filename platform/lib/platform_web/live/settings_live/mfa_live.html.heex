<div class="space-y-8 max-w-xl md:mx-auto mx-4">
  <h1 class="page-header"><%= gettext("Multi-Factor Authentication") %></h1>

  <.mfa_status user={@current_user} />

  <%= if not @current_user.has_mfa do %>
    <.card>
      <:header>
        <h3 class="sec-head"><%= gettext("Enable Multi-Factor Authentication") %></h3>
        <p class="sec-subhead">
          <%= gettext("Multi-factor authentication helps keep your account secure.") %>
        </p>
      </:header>
      <div class="prose prose-sm">
        <%= if @secret do %>
          <p>
            <%= gettext("To enable MFA, scan the following code using your multi-factor authentication app.") %>
          </p>
          <p class="flex justify-around">
            <%= secret_qr_code(@current_user, @secret) %>
          </p>
          <p>
            <%= gettext("If you cannot scan the code, you can also add the code to your MFA application manually using this link: %{url_link}. To finish setting up MFA, enter the current code below:", url_link: safe_to_string(~H|<a href={secret_url(@current_user, @secret)} class="font-mono">{secret_url(@current_user, @secret)}</a>|)) |> raw() %>
          </p>
          <.form
            :let={f}
            for={@enable_changeset}
            as={:enable_mfa}
            phx-submit="save_enable_mfa"
            class="phx-form"
          >
            <div>
              <%= label(f, :current_otp_code, gettext("Current Code")) %>
              <%= text_input(f, :current_otp_code,
                placeholder: gettext("Enter the code from your authenticator app..."),
                class: "my-1"
              ) %>
              <%= error_tag(f, :current_otp_code) %>
            </div>
            <%= submit(gettext("Enable MFA"),
              phx_disable_with: gettext("Saving..."),
              class: "button ~urge @high mt-4"
            ) %>
          </.form>
        <% else %>
          <p>
            <%= gettext("Multi-factor authentication is a crucial way that we keep Atlos secure. To learn more about MFA (also known as 2FA) and to discover authenticator apps, visit %{mfa_info_link}.", mfa_info_link: safe_to_string(~H|<a href="https://twofactorauth.org">TwoFactorAuth.org</a>|)) |> raw() %>
          </p>
          <p>
            <%= gettext("Once you're ready to enable MFA, get your authenticator app ready and press the button below.") %>
          </p>
          <button
            class="button ~urge @high"
            phx-click="generate_code"
            phx-disable-with={gettext("Generating code...")}
          >
            <%= gettext("Setup Multi-Factor Authentication") %>
          </button>
        <% end %>
      </div>
    </.card>
  <% else %>
    <%= if @otp_passed do %>
      <.live_component
        module={PlatformWeb.SettingsLive.BackupComponent}
        id="backup-codes-component"
        current_user={@current_user}
      />
      <.card>
        <:header>
          <h3 class="sec-head"><%= gettext("Disable Multi-Factor Authentication") %></h3>
          <p class="sec-subhead">
            <%= gettext("If you want, you can disable MFA here. To setup a new MFA code, disable then re-enable MFA.") %>
          </p>
        </:header>
        <div class="prose prose-sm">
          <p><%= gettext("To disable MFA, please enter your password below.") %></p>
          <.form
            :let={f}
            for={@disable_changeset}
            as={:disable_mfa}
            phx-submit="save_disable_mfa"
            class="phx-form"
          >
            <div>
              <%= label(f, :password, gettext("Password")) %>
              <%= password_input(f, :password,
                placeholder: gettext("Enter your current password"),
                class: "my-1"
              ) %>
              <%= error_tag(f, :password) %>
            </div>
            <%= submit(gettext("Disable MFA"),
              phx_disable_with: gettext("Saving..."),
              class: "button ~urge @high mt-4"
            ) %>
          </.form>
        </div>
      </.card>
    <% else %>
      <.card>
        <:header>
          <p class="sec-head"><%= gettext("Security Check") %></p>
          <p class="sec-subhead">
            <%= gettext("To view your backup codes or disable MFA, please enter your current MFA code below.") %>
          </p>
        </:header>
        <.form :let={f} as={:access_otp} phx-submit="access_otp" for={@otp_gate} class="phx-form">
          <div class="prose prose-sm">
            <%= label(f, :current_otp_code, gettext("Current Code")) %>
            <%= text_input(f, :current_otp_code,
              placeholder: gettext("Enter the code from your authenticator app..."),
              class: "my-1",
              required: true
            ) %>
            <%= error_tag(f, :current_otp_code) %>
          </div>
          <%= submit(gettext("Continue"),
            phx_disable_with: gettext("Validating..."),
            class: "button ~urge @high mt-4"
          ) %>
        </.form>
      </.card>
    <% end %>
  <% end %>

  <.link navigate="/settings" class="text-button mt-4 block">&larr; <%= gettext("View All Settings") %></.link>
</div>
